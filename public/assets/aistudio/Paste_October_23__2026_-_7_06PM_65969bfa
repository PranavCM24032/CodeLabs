<script>
  function togglePassVisibility(inputId, triggerBtn) {
    const input = document.getElementById(inputId);
    const icon = triggerBtn.querySelector('.material-symbols-outlined');
    if (!input || !icon) return;
    
    if (input.type === 'password') {
      input.type = 'text';
      icon.textContent = 'visibility_off';
    } else {
      input.type = 'password';
      icon.textContent = 'visibility';
    }
  }

  function evaluatePassword(val) {
    const b1 = document.getElementById('bar-1');
    const b2 = document.getElementById('bar-2');
    const b3 = document.getElementById('bar-3');
    const b4 = document.getElementById('bar-4');
    const status = document.getElementById('strength-status');

    if (!b1 || !b2 || !b3 || !b4 || !status) return;

    if (!val || val.length === 0) {
      status.textContent = 'Empty';
      status.className = 'text-outline font-label-sm text-label-sm';
      b1.className = 'h-full flex-1 bg-surface-container-highest rounded-full transition-all';
      b2.className = 'h-full flex-1 bg-surface-container-highest rounded-full transition-all';
      b3.className = 'h-full flex-1 bg-surface-container-highest rounded-full transition-all';
      b4.className = 'h-full flex-1 bg-surface-container-highest rounded-full transition-all';
      return;
    }

    let score = 0;
    if (val.length >= 6) score++;
    if (val.length >= 12) score++;
    if (/[0-9]/.test(val) && /[a-zA-Z]/.test(val)) score++;
    if (/[^A-Za-z0-9]/.test(val)) score++;

    if (score <= 1) {
      status.textContent = 'Weak: Use 12+ chars & symbols';
      status.className = 'text-error font-label-sm text-label-sm';
      b1.className = 'h-full flex-1 bg-error rounded-full transition-all';
      b2.className = 'h-full flex-1 bg-surface-container-highest rounded-full transition-all';
      b3.className = 'h-full flex-1 bg-surface-container-highest rounded-full transition-all';
      b4.className = 'h-full flex-1 bg-surface-container-highest rounded-full transition-all';
    } else if (score <= 2) {
      status.textContent = 'Fair: Add special characters';
      status.className = 'text-tertiary font-label-sm text-label-sm';
      b1.className = 'h-full flex-1 bg-tertiary rounded-full transition-all';
      b2.className = 'h-full flex-1 bg-tertiary rounded-full transition-all';
      b3.className = 'h-full flex-1 bg-surface-container-highest rounded-full transition-all';
      b4.className = 'h-full flex-1 bg-surface-container-highest rounded-full transition-all';
    } else if (score === 3) {
      status.textContent = 'Good: Almost rock-solid';
      status.className = 'text-primary font-label-sm text-label-sm';
      b1.className = 'h-full flex-1 bg-primary rounded-full transition-all';
      b2.className = 'h-full flex-1 bg-primary rounded-full transition-all';
      b3.className = 'h-full flex-1 bg-primary rounded-full transition-all';
      b4.className = 'h-full flex-1 bg-surface-container-highest rounded-full transition-all';
    } else {
      status.textContent = 'Strong: 12+ chars, symbols';
      status.className = 'text-secondary font-label-sm text-label-sm';
      b1.className = 'h-full flex-1 bg-secondary rounded-full transition-all';
      b2.className = 'h-full flex-1 bg-secondary rounded-full transition-all';
      b3.className = 'h-full flex-1 bg-secondary rounded-full transition-all';
      b4.className = 'h-full flex-1 bg-secondary rounded-full transition-all';
    }
  }

  // Pre-fill visual state for polished instant view
  document.addEventListener('DOMContentLoaded', () => {
    evaluatePassword("Forensic#Secure2025!");
  });
</script></main></body></html>

