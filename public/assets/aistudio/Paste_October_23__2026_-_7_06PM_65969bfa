  // Tab switching interaction
  const tabs = document.querySelectorAll('.tab-btn');
  const panels = document.querySelectorAll('.tab-panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      // Deactivate all buttons
      tabs.forEach(t => {
        t.classList.remove('bg-surface-container-highest', 'text-on-surface', 'font-semibold');
        t.classList.add('text-on-surface-variant');
      });

      // Activate clicked tab button
      tab.classList.remove('text-on-surface-variant');
      tab.classList.add('bg-surface-container-highest', 'text-on-surface', 'font-semibold');

      // Hide all panels
      panels.forEach(p => p.classList.add('hidden'));

      // Show targeted panel
      const targetId = tab.getAttribute('data-target');
      const targetPanel = document.getElementById(targetId);
      if (targetPanel) {
        targetPanel.classList.remove('hidden');
      }
    });
  });

  // Role toggle interaction for demoing participant vs non-registered state
  const toggleBtn = document.getElementById('toggle-user-role');
  const ctaBtn = document.getElementById('cta-action-btn');
  const ctaLabel = document.getElementById('cta-label');
  let isRegistered = true;

  toggleBtn.addEventListener('click', () => {
    isRegistered = !isRegistered;
    if (isRegistered) {
      ctaLabel.textContent = 'Submit Repository (Registered)';
      ctaBtn.classList.remove('bg-primary', 'text-on-primary');
      ctaBtn.classList.add('bg-primary-container', 'text-on-primary-container');
      toggleBtn.textContent = 'Switch to Participant View';
    } else {
      ctaLabel.textContent = 'Register as Participant';
      ctaBtn.classList.remove('bg-primary-container', 'text-on-primary-container');
      ctaBtn.classList.add('bg-primary', 'text-on-primary');
      toggleBtn.textContent = 'Switch to Registered View';
    }
  });

  // Live countdown simulator
  let totalSeconds = (6 * 3600) + (41 * 60) + 12;
  const countdownEl = document.getElementById('countdown-timer');

  setInterval(() => {
    if (totalSeconds > 0) {
      totalSeconds--;
      const hours = String(Math.floor(totalSeconds / 3600)).padStart(2, '0');
      const minutes = String(Math.floor((totalSeconds % 3600) / 60)).padStart(2, '0');
      const seconds = String(totalSeconds % 60).padStart(2, '0');
      countdownEl.textContent = `${hours}h ${minutes}m ${seconds}s`;
    }
  }, 1000);
